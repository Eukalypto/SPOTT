{
  "name": "spott",
  "version": "0.1.0",
  "description": "Core game engine for Spott — a timed mobile word-search game",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:wordsets": "npm run build --silent && node scripts/validate-wordsets.mjs",
    "prototype:dev": "npm run dev --prefix prototype",
    "prototype:build": "npm run build --prefix prototype",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
